#!/usr/bin/env bash
export PATH="/opt/homebrew/bin:$PATH"
export USER="${USER:-$(id -un)}"
# SIGKILL the app owning the focused window (works on frozen apps). Falls back to the frontmost
# app as macOS sees it when yabai has lost track of focus (e.g. Infuse/Catalyst video players).
pid=$(yabai -m query --windows --window 2>/dev/null | jq -r .pid)
[[ $pid =~ ^[0-9]+$ ]] || pid=$(lsappinfo info -only pid "$(lsappinfo front)" | sed 's/.*=//')
[[ $pid =~ ^[0-9]+$ ]] && [ "$pid" -gt 1 ] && kill -9 "$pid"
