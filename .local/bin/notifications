#!/usr/bin/env bash
# Omarchy's notification binds on macOS (SUPER+comma family):
#   notifications dismiss      close the newest notification (a banner on screen, or the top of Notification Center)
#   notifications dismiss-all  clear every notification in Notification Center
#   notifications center       toggle Notification Center (history)
# Notifications are groups in NotificationCenter's window with a "Close" accessibility action.
cmd=${1:-dismiss}

is_open() { [ "$(osascript -l JavaScript -e 'Application("System Events").processes["NotificationCenter"].windows().some(w => w.name() === "Notification Center")' 2>/dev/null)" = true ]; }
# open by clicking the clock; a second scripted click doesn't close it, a real Escape key event does
# (sendkey posts one; System Events' "key code 53" doesn't reach it)
center() {
	if is_open; then ~/.local/bin/sendkey escape
	else osascript -e 'tell application "System Events" to tell process "ControlCenter" to click (first menu bar item of menu bar 1 whose description is "Clock")' >/dev/null 2>&1; fi
}

# close notifications (all or just the first); prints how many were closed
close() {
	osascript -l JavaScript - "$1" <<'JS'
function run(argv) {
	const all = argv[0] === "all";
	const nc = Application("System Events").processes["NotificationCenter"];
	let closed = 0;
	for (let pass = 0; pass < 50; pass++) {
		if (!nc.windows().length) break;
		let target = null;
		const walk = (e, d) => {
			if (target || d > 7) return;
			try { if (e.role() === "AXGroup" && e.actions().some(a => a.name().includes("Name:Close"))) { target = e; return; } } catch (x) {}
			try { e.uiElements().forEach(k => walk(k, d + 1)); } catch (x) {}
		};
		walk(nc.windows[0], 0);
		if (!target) break;
		target.actions().find(a => a.name().includes("Name:Close")).perform();
		closed++;
		if (!all) break;
		delay(0.15);
	}
	return closed;
}
JS
}

case $cmd in
	center) center ;;
	dismiss) close one >/dev/null ;;
	dismiss-all)
		# clearing history needs Notification Center open; leave it how it was
		if is_open; then close all >/dev/null
		else center; sleep 0.5; close all >/dev/null; center; fi
		;;
esac
