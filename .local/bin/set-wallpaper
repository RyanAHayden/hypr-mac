#!/bin/bash
# set-wallpaper IMAGE: desktop picture on every Space and display, including ones made later.
# System Events sets it the supported way, which writes a store entry WallpaperAgent accepts (with a file
# bookmark; a hand-written entry without one falls back to the default wallpaper) but only for the
# current Space. Turn that entry into Wallpaper settings' "Show on all Spaces" (one AllSpacesAndDisplays
# entry, no per-Space or per-display ones), then restart the agent so it re-reads the store.
set -euo pipefail
[ -f "${1:-}" ] || { echo "usage: set-wallpaper IMAGE" >&2; exit 1; }
# Set it from a copy in ~/Pictures/Wallpapers: macOS stores the resolved file path (it follows the symlink into the repo),
# so a path inside the repo breaks when the repo is moved or renamed (it reset to the default when macos-config became
# hypr-mac). The copy's path never changes.
mkdir -p "$HOME/Pictures/Wallpapers"
img="$HOME/Pictures/Wallpapers/$(basename "$1")"
cp -f "$1" "$img"

osascript -e "tell application \"System Events\" to tell every desktop to set picture to POSIX file \"$img\""
sleep 1
/usr/bin/python3 -I - <<'PY'
import copy, pathlib, plistlib
p = pathlib.Path.home() / "Library/Application Support/com.apple.wallpaper/Store/Index.plist"
d = plistlib.loads(p.read_bytes())
# the entry System Events just wrote: the most recently set one, wherever it landed
entries = [d.get("AllSpacesAndDisplays"), d.get("SystemDefault")]
for space in d.get("Spaces", {}).values():
    entries += [space.get("Default"), *space.get("Displays", {}).values()]
entries += d.get("Displays", {}).values()
new = max((e for e in entries if e and "Desktop" in e), key=lambda e: e["Desktop"].get("LastSet", 0))
d["AllSpacesAndDisplays"] = copy.deepcopy(new)
d["SystemDefault"] = copy.deepcopy(new)
d["Spaces"] = {}
d["Displays"] = {}
p.write_bytes(plistlib.dumps(d, fmt=plistlib.FMT_BINARY))
PY
launchctl kickstart -k "gui/$(id -u)/com.apple.wallpaper.agent"
