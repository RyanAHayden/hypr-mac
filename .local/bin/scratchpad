#!/usr/bin/env bash
# Omarchy's scratchpad as a workspace: the 11th Space, tiled like any other. It isn't in the bar: it stands in
# for the Space you came from, which stays lit there, and SUPER+A/D go on from that one. Discord, Spotify and KeePassXC live there (yabairc rules), like scratch-app on Hyprland.
#   scratchpad toggle   go to the scratchpad, or back to the Space you came from if you're on it
#   scratchpad show     go to the scratchpad (stay if already there)
#   scratchpad move     send the focused window there (stay here); on the scratchpad, send it back instead
export PATH="/opt/homebrew/bin:$PATH"
pad=11
back=~/.cache/scratchpad-return
cur=$(yabai -m query --spaces --space | jq .index) || exit 1
ret=$(cat "$back" 2>/dev/null); [ -n "$ret" ] && [ "$ret" != $pad ] || ret=1
case $1 in
	toggle)
		if [ "$cur" = $pad ]; then ~/.local/bin/ws focus "$ret"
		else echo "$cur" >"$back"; ~/.local/bin/ws focus $pad; fi
		;;
	show) [ "$cur" = $pad ] || { echo "$cur" >"$back"; ~/.local/bin/ws focus $pad; } ;;
	move)
		if [ "$cur" = $pad ]; then ~/.local/bin/ws move-silent "$ret"
		else ~/.local/bin/ws move-silent $pad; fi
		;;
esac
