#!/usr/bin/env bash
# Option+Tab / Option+Shift+Tab: focus the next/previous window on this workspace, tiled and floating alike
# (yabai's own --focus next/prev only walks the tiling tree), left to right then top to bottom, wrapping around.
# A fullscreen (SUPER+F) window's frame is the whole Space, which would sort it first every time and bounce between
# two windows as the zoom follows focus, so while one is zoomed it keeps the order saved when none was.
export PATH="/opt/homebrew/bin:$PATH"
cache="$HOME/.cache/window-cycle"
space=$(yabai -m query --spaces --space | jq .id)
mkdir -p "$cache"
saved=$(cat "$cache/$space" 2>/dev/null)
{ read -r order; read -r id; } < <(yabai -m query --windows --space | jq -r -c --arg dir "${1:-next}" --argjson saved "${saved:-[]}" '
	[.[] | select(."is-visible" and ."is-minimized" == false and ."is-hidden" == false)] as $all
	| [$all | sort_by(.frame.x, .frame.y)[].id] as $byframe
	| (if any($all[]; ."has-fullscreen-zoom") then
		[$saved[] | select(IN($byframe[]))] as $kept | $kept + [$byframe[] | select(IN($kept[]) | not)]
	  else $byframe end) as $w
	| ($w | length) as $n
	| ($w | tojson),
	  (if $n < 2 then "" else
		([$all[] | select(."has-focus")][0].id) as $f
		| ($w | index($f) // -1) as $i
		| $w[(($i + (if $dir == "prev" then -1 else 1 end)) % $n + $n) % $n] end)')
echo "$order" >"$cache/$space"
[ -n "$id" ] && yabai -m window --focus "$id"
