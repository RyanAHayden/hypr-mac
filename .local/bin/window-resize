#!/usr/bin/env bash
# Grow (+) or shrink (-) the focused window by px, Omarchy SUPER+-/= style. Usage: window-resize w|h <px>
# yabai resizes a tiled window by dragging the edge it shares with a neighbour, so drag the right/bottom edge
# when there's a window that side, else the left/top one the other way. Floating windows grow from bottom-right.
export PATH="/opt/homebrew/bin:$PATH"
d=$2
if [ "$(yabai -m query --windows --window | jq '."is-floating"')" = true ]; then
	case $1 in w) yabai -m window --resize "bottom_right:$d:0" ;; h) yabai -m window --resize "bottom_right:0:$d" ;; esac
	exit
fi
case $1 in
	w) if yabai -m query --windows --window east >/dev/null 2>&1; then yabai -m window --resize "right:$d:0"; else yabai -m window --resize "left:$((-d)):0"; fi ;;
	h) if yabai -m query --windows --window south >/dev/null 2>&1; then yabai -m window --resize "bottom:0:$d"; else yabai -m window --resize "top:0:$((-d))"; fi ;;
esac
