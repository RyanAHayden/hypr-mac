#!/usr/bin/env bash
# Window transparency, like Omarchy. Usage: window-opacity toggle | +0.05 | -0.05
# Unfocused windows are see-through, and the apps in ~/.config/yabai/see-through slightly while focused too (yabairc,
# yabai-helper). toggle (SUPER+Backspace): the focused window fully opaque, focused or not, until toggled again. +/- (Option+Backspace) changes how see-through unfocused windows are.
# Needs the scripting addition (yabai's opacity).
export PATH="/opt/homebrew/bin:$PATH"
case $1 in
	toggle)
		w=$(yabai -m query --windows --window) || exit 1
		id=$(jq .id <<<"$w")
		mark=~/.cache/yabai-opaque/$id   # yabairc drops it when the window closes, so a reused id starts see-through
		if [ -e "$mark" ]; then
			rm "$mark"
			yabai -m window "$id" --opacity 0.0   # 0 = back to yabairc's focused/unfocused opacity
			~/.local/bin/notify-post wm.opaque   # a focused see-through app goes back to slightly see-through (yabai-helper)
		else
			mkdir -p "${mark%/*}" && touch "$mark"
			yabai -m window "$id" --opacity 1.0
		fi
		;;
	*)
		new=$(awk -v c="$(yabai -m config normal_window_opacity)" -v d="$1" 'BEGIN { n = c + d; if (n > 1) n = 1; if (n < 0.2) n = 0.2; printf "%.2f", n }')
		yabai -m config normal_window_opacity "$new" window_opacity on
		;;
esac
