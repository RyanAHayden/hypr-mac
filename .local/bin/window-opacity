#!/usr/bin/env bash
# Unfocused windows are see-through, the focused one opaque (yabai window_opacity, yabairc; needs the scripting
# addition). Usage: window-opacity toggle | +0.05 | -0.05
# toggle turns that on and off, like Omarchy SUPER+Backspace; +/- changes how see-through unfocused windows are.
export PATH="/opt/homebrew/bin:$PATH"
case $1 in
	toggle) [ "$(yabai -m config window_opacity)" = on ] && yabai -m config window_opacity off || yabai -m config window_opacity on ;;
	*)
		new=$(awk -v c="$(yabai -m config normal_window_opacity)" -v d="$1" 'BEGIN { n = c + d; if (n > 1) n = 1; if (n < 0.2) n = 0.2; printf "%.2f", n }')
		yabai -m config normal_window_opacity "$new" window_opacity on
		;;
esac
