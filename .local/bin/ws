#!/usr/bin/env bash
export PATH="/opt/homebrew/bin:$PATH"
export USER="${USER:-$(id -un)}"
# Omarchy-style workspace actions on yabai. Usage: ws focus|move|move-silent <N|prev|next>, ws focus recent
# (move-silent sends the window there and stays put; recent = the Space you were on before)
# Focusing a Space needs yabai's scripting addition (SIP off); without it, fall back
# to macOS's own "Switch to Desktop" shortcuts (ctrl+alt+cmd+N, setup.sh; prev/next are resolved to N below).
# The 11th Space is the scratchpad (.local/bin/scratchpad), the 12th where SUPER+M parks windows (yabai-helper).
action=$1 target=$2
# SUPER+Shift+N: yabai-helper switches and moves over yabai's socket, back to back, so the move doesn't flash (yabai only
# tiles visible Spaces: moving first shows the window at its old size; two yabai commands from here leave the empty
# Space showing for ~10 ms). Straight away, before the lock and queries below, for the fastest key press.
helper_up() { kill -0 "$(cat ~/.cache/yabai-helper.pid 2>/dev/null)" 2>/dev/null; }
[ "$action" = move ] && [[ $target =~ ^[0-9]+$ ]] && helper_up && exec ~/.local/bin/notify-post wm.move "$target"
# Holding a bind fires a run every key repeat (~30ms). Runs that overlap read focus
# mid-switch and grab the wrong window, and queued ones lag; so one at a time, and
# repeats that arrive while one is running are dropped instead of queued.
[ -z "$WS_LOCKED" ] && WS_LOCKED=1 exec lockf -t 0 "${TMPDIR:-/tmp}/ws.lock" "$0" "$@" 2>/dev/null
# Native fullscreen Desktops belong to the workspace they came from (.local/bin/fs-origin records it):
# {"<fullscreen space id>": <origin space id>}
fs_map() { local f m="{}"; for f in ~/.cache/fs-origin/*; do [ -e "$f" ] && m=$(jq -c --arg k "${f##*/}" --argjson v "$(<"$f")" '. + {($k): $v}' <<<"$m"); done; echo "$m"; }
# prev/next go through 1..10 and wrap around at either end, skipping the scratchpad (11) and parked windows (12);
# a fullscreen Desktop comes right after its workspace (2, 2's fullscreen app, 3, ...). On the scratchpad they go from
# the workspace you came from (it stands in for that one, .local/bin/scratchpad)
if [ "$target" = prev ] || [ "$target" = next ]; then
	cur=$(yabai -m query --spaces --space | jq .index)
	if [ "$cur" = 11 ]; then cur=$(cat ~/.cache/scratchpad-return 2>/dev/null); [[ $cur =~ ^[0-9]+$ ]] && [ "$cur" != 11 ] || cur=1; fi
	resolved=$(yabai -m query --spaces --display | jq -r --arg dir "$target" --argjson map "$(fs_map)" \
		--argjson cur "$cur" '
		(map({key: (.id | tostring), value: .index}) | from_entries) as $at
		| [.[] | select(."is-native-fullscreen") | {index, origin: ($at[($map[(.id | tostring)] // -1) | tostring] // null)}] as $fs
		| [.[] | select(."is-native-fullscreen" | not) | .index | select(. < 11 or . == $cur)] | sort
		| (reduce .[] as $n ([]; . + [$n] + [$fs[] | select(.origin == $n) | .index])) as $placed
		| ($placed + [$fs[] | .index | select(. as $i | $placed | index($i) | not)]) as $o
		| ($o | index($cur)) as $i
		| $o[(($i + (if $dir == "next" then 1 else -1 end)) % ($o | length) + ($o | length)) % ($o | length)]') &&
		[ -n "$resolved" ] && target=$resolved
# SUPER+N: when workspace N's only window is fullscreen (or you're already on N), go to its fullscreen Desktop
elif [ "$action" = focus ] && [[ $target =~ ^[0-9]+$ ]] && [ -n "$(ls -A ~/.cache/fs-origin 2>/dev/null)" ]; then
	resolved=$(jq -rn --argjson n "$target" --argjson map "$(fs_map)" --argjson spaces "$(yabai -m query --spaces)" \
		--argjson windows "$(yabai -m query --windows)" '
		($spaces | map(select(.index == $n)) | first) as $ws
		| [$spaces[] | select(."is-native-fullscreen" and ($map[(.id | tostring)] == $ws.id)) | .index] as $kids
		| [$windows[] | select(.space == $n and ."is-sticky" == false and ."is-minimized" == false and ."is-hidden" == false)] as $own
		| if ($kids | length) > 0 and (($own | length) == 0 or $ws."has-focus") then $kids[0] else empty end') &&
		[ -n "$resolved" ] && target=$resolved
fi
fallback() {
	case $target in
		prev | next) ;; # resolved to a number above unless yabai couldn't be queried
		recent) ;; # no macOS shortcut for the previous Desktop; needs the scripting addition
		10) ~/.local/bin/sendkey "ctrl + alt + cmd - 0" ;;
		11) ;; # no macOS Desktop shortcut for 11; needs the scripting addition
		*) ~/.local/bin/sendkey "ctrl + alt + cmd - $target" ;;
	esac
}
# Switching Spaces makes macOS activate an app (landing on an empty Space hands focus
# to e.g. Finder; a move re-activates the moved window's app before yabai sees it
# there). Tell the instant alt-tab helper those aren't alt-tabs, or it jumps to that
# app's window on another Space.
touch ~/.cache/ws-switch
case $action in
	focus) yabai -m space --focus "$target" 2>/dev/null || fallback ;;
	move)
		helper_up && exec ~/.local/bin/notify-post wm.move "$target" # prev/next, now resolved (see the top)
		# Without the helper: switch first, then move the window onto the now-visible Space
		id=$(yabai -m query --windows --window | jq -r .id)
		[ -n "$id" ] && [ "$id" != null ] || exit 1
		if yabai -m space --focus "$target" 2>/dev/null; then
			yabai -m window "$id" --space "$target" || exit 1
		else
			yabai -m window "$id" --space "$target" || exit 1
			fallback
		fi
		yabai -m window --focus "$id" 2>/dev/null
		;;
	move-silent)
		yabai -m window --space "$target" || exit 1
		# focus a window left on this Space (not the moved one, which would pull us over to it)
		next=$(yabai -m query --windows --space | jq -r 'first(.[] | select(."is-visible" and ."is-minimized" == false and ."has-focus" == false)) | .id')
		[ -n "$next" ] && yabai -m window --focus "$next" 2>/dev/null
		;;
esac
