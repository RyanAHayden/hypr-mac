#!/usr/bin/env bash
export PATH="/opt/homebrew/bin:$PATH"
export USER="${USER:-$(id -un)}"
# Omarchy-style workspace actions on yabai. Usage: ws focus|move <N|prev|next>
# Focusing a Space needs yabai's scripting addition (SIP off); without it, fall back
# to macOS's own "Switch to Desktop" shortcuts (ctrl+N / ctrl+arrows).
# Workspace "0" (SUPER+~, left of 1) is the 11th Space.
action=$1 target=$2
[ "$target" = 0 ] && target=11
# Holding a bind fires a run every key repeat (~30ms). Runs that overlap read focus
# mid-switch and grab the wrong window, and queued ones lag; so one at a time, and
# repeats that arrive while one is running are dropped instead of queued.
[ -z "$WS_LOCKED" ] && WS_LOCKED=1 exec lockf -t 0 "${TMPDIR:-/tmp}/ws.lock" "$0" "$@" 2>/dev/null
# prev/next follow the bar's order (0, 1..10) and wrap around at either end
if [ "$target" = prev ] || [ "$target" = next ]; then
	resolved=$(yabai -m query --spaces --display | jq -r --arg dir "$target" --argjson cur "$(yabai -m query --spaces --space | jq .index)" '
		[.[].index] | sort_by(if . == 11 then 0 else . end) as $o
		| ($o | index($cur)) as $i
		| $o[(($i + (if $dir == "next" then 1 else -1 end)) % ($o | length) + ($o | length)) % ($o | length)]') &&
		[ -n "$resolved" ] && target=$resolved
fi
fallback() {
	case $target in
		prev) skhd -k "ctrl - left" ;;
		next) skhd -k "ctrl - right" ;;
		10) skhd -k "ctrl - 0" ;;
		11) ;; # no macOS Desktop shortcut for 11; needs the scripting addition
		*) skhd -k "ctrl - $target" ;;
	esac
}
# Switching Spaces makes macOS activate an app (landing on an empty Space hands focus
# to e.g. Finder; a move re-activates the moved window's app before yabai sees it
# there). Tell the instant alt-tab helper those aren't alt-tabs, or it jumps to that
# app's window on another Space.
touch ~/.cache/ws-switch
case $action in
	focus) yabai -m space --focus "$target" 2>/dev/null || fallback ;;
	move)
		id=$(yabai -m query --windows --window | jq -r .id)
		[ -n "$id" ] && [ "$id" != null ] || exit 1
		yabai -m window "$id" --space "$target" || exit 1
		yabai -m space --focus "$target" 2>/dev/null || fallback
		yabai -m window --focus "$id" 2>/dev/null
		;;
esac
