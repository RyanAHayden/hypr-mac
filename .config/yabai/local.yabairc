#!/usr/bin/env bash
# Personal yabai overrides, sourced at the end of the Macarchy yabairc.
# Mirrors github.com/RyanAHayden/dotfiles (Omarchy/Hyprland) where macOS allows.

# SUPER(Option)+drag moves, SUPER+right-drag resizes, like Hyprland
"$YABAI_BIN" -m config mouse_modifier alt
"$YABAI_BIN" -m config mouse_drop_action swap

# Popups that shouldn't tile
replace_rule ryha_raycast  app="^Raycast$"  manage=off
replace_rule ryha_alttab   app="^AltTab$"   manage=off
replace_rule ryha_davinci  app="^DaVinci Resolve$" manage=off
replace_rule ryha_settings_float app="^(Syncthing|Archive Utility|Installer)$" manage=off

# SwiftBar workspace indicator (~/.config/swiftbar/workspace.sh): poke its FIFO to redraw now
ryha_ws_poke='f="$HOME/.cache/ryha-workspace.fifo"; [ -p "$f" ] && { exec 3<>"$f"; echo >&3; }'
"$YABAI_BIN" -m signal --remove ryha_swiftbar_space 2>/dev/null || true
for ev in space_changed display_changed space_created space_destroyed window_created window_destroyed; do
  replace_signal "ryha_ws_$ev" "$ev" "/bin/bash -c '$ryha_ws_poke'"
done
