#!/usr/bin/env bash
# yabai config. Mirrors github.com/RyanAHayden/dotfiles (Omarchy/Hyprland) where macOS allows.
# Reload: yabai --restart-service (or SUPER+Option+Y)
export PATH="/opt/homebrew/bin:$PATH"
CONFIG_ROOT="$HOME/.config/yabai"
signal() { yabai -m signal --remove "$1" 2>/dev/null; yabai -m signal --add label="$1" event="$2" action="$3"; }
rule()   { local l=$1; shift; yabai -m rule --remove "$l" 2>/dev/null; yabai -m rule --add label="$l" "$@"; }

# --- Scripting addition ------------------------------------------------------
# Needs SIP off + the sudoers rule setup.sh writes (see README).
# The Dock loses it whenever it restarts, so reload on dock_did_restart.
signal load_sa dock_did_restart "sudo -n $(command -v yabai) --load-sa"
if sudo -n "$(command -v yabai)" --load-sa 2>/dev/null || yabai -m window --opacity 1.0 2>/dev/null; then
  sa=1
fi

# --- Layout ------------------------------------------------------------------
yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config split_type auto
yabai -m config auto_balance off
yabai -m config top_padding 8 bottom_padding 8 left_padding 8 right_padding 8 window_gap 8

# --- Mouse: SUPER(Cmd)+drag moves, SUPER+right-drag resizes ------------------
yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse autofocus   # hover focuses (like Hyprland), without raising floating windows
yabai -m config mouse_modifier cmd   # SUPER+Shift+P pauses yabai so Cmd-drag reaches macOS (menu bar icons)
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

# --- yabai-helper (~/.local/src/yabai-helper.swift): workspace bar, mouse follows focus, focus after close ---
# It does the work natively and talks to yabai over its socket; these just ping it (notify-post takes ~1 ms).
post="$HOME/.local/bin/notify-post"
for ev in space_changed display_changed space_created space_destroyed window_created; do
  signal "bar_$ev" "$ev" "$post wm.bar"
done
for ev in window_focused window_moved window_resized; do
  signal "focus_$ev" "$ev" "$post wm.focus"
done
# these also redraw the bar; minimize/restore also keep minimized windows sticky (restore lands on this Space)
for ev in window_destroyed window_minimized application_terminated; do
  signal "closed_$ev" "$ev" "$post wm.closed"
done
signal demin window_deminimized "$post wm.demin"

# --- Floating apps -----------------------------------------------------------
rule float_settings app="^(System Settings|Calculator|Syncthing|Archive Utility|Installer|Raycast|AltTab|DaVinci Resolve|Safari|Tailscale|Karabiner-Elements)$" manage=off
rule float_finder_ops app="^Finder$" title="^(Copy|Move|Delete|Trash)$" manage=off
# Spotify, Discord and KeePassXC live on the scratchpad (Space 11, SUPER+S). Their skhd binds go there;
# the rules only place windows, so an app starting by itself (login) doesn't pull you over.
# KeePassXC: only its main window (title ends "KeePassXC"), not browser-access popups over the browser.
rule pad_apps app="^(Spotify|Discord)$" space=11
rule pad_keepass app="^KeePassXC$" title="KeePassXC$" space=11

# --- With the scripting addition: instant alt-tab (no yabai animations) ------
yabai -m config window_animation_duration 0.0
if [ -n "$sa" ]; then
  # Stop macOS fading to the app's Space on alt-tab; yabai-helper jumps instantly (it reads this setting)
  if [ "$(defaults read -g AppleSpacesSwitchOnActivate 2>/dev/null)" != 0 ]; then
    defaults write -g AppleSpacesSwitchOnActivate -bool false
    killall Dock   # dock_did_restart reloads the SA
  fi
  # Closing a workspace's last window (red button, an app's own Cmd+W) also makes macOS activate another
  # app; mark it so yabai-helper's alt-tab jump stays put. Best effort: this can race the activation (SUPER+W/Q mark first).
  signal stay_on_close window_destroyed "touch $HOME/.cache/ws-switch"
  signal stay_on_quit application_terminated "touch $HOME/.cache/ws-switch"
  # SUPER+O (.local/bin/window-pop) marks popped windows; drop the marker so a reused id starts unpopped
  signal pop_gone window_destroyed "rm -f $HOME/.cache/yabai-pop/\$YABAI_WINDOW_ID"
else
  # No SA: nothing could switch Spaces for us, so hand it back to macOS
  yabai -m signal --remove stay_on_close 2>/dev/null; yabai -m signal --remove stay_on_quit 2>/dev/null; yabai -m signal --remove pop_gone 2>/dev/null
  if [ "$(defaults read -g AppleSpacesSwitchOnActivate 2>/dev/null)" = 0 ]; then
    defaults delete -g AppleSpacesSwitchOnActivate
    killall Dock
  fi
fi
