# Omarchy-style bindings, ported from github.com/RyanAHayden/dotfiles (.config/hypr/bindings.lua)
# SUPER = left Option (lalt). SUPER+ALT = left Option + Cmd. Cmd alone is left to macOS apps.
# Right Option is never bound here, so it still reaches tmux as Meta (M-1..9, M-Enter, ...).
# Reload: skhd --restart-service

# --- Apps ------------------------------------------------------------------
lalt - return                 : /bin/bash ~/.config/yabai/launch_ghostty.sh
lalt + cmd - return           : open -na Ghostty --args -e /opt/homebrew/bin/tmux new -A -s Work
lalt - space                  : open -a Raycast
lalt + shift - b              : open -na Zen
lalt + shift - return         : open -na Zen --args --blank-window
lalt + shift + cmd - b        : open -na Zen --args --private-window
lalt + shift - f              : open ~
lalt + shift - n              : open -na Ghostty --args -e /opt/homebrew/bin/nvim
lalt + shift - t              : open -na Ghostty --args -e /opt/homebrew/bin/btop
lalt + shift - g              : open -a Steam
lalt + shift - s              : open "x-apple.systempreferences:com.apple.Sound-Settings.extension"
lalt + ctrl - b               : open "x-apple.systempreferences:com.apple.BluetoothSettings"
lalt - i                      : open -na Ghostty --args -e /usr/bin/less ~/.config/skhd/local.skhdrc


# --- Windows ---------------------------------------------------------------
lalt - w                      : yabai -m window --close
lalt + shift - w              : ~/.local/bin/force-kill-window
lalt - f                      : yabai -m window --toggle zoom-fullscreen
lalt + cmd - f                : yabai -m window --toggle native-fullscreen
lalt - t                      : /bin/bash ~/.config/yabai/toggle_float_persist.sh
lalt - 0x2A                   : yabai -m window --toggle split
lalt + shift - i              : yabai -m window --swap largest
lalt + ctrl + shift - i       : yabai -m space --mirror y-axis
lalt - 0x1B                   : yabai -m window --ratio rel:-0.05
lalt - 0x18                   : yabai -m window --ratio rel:0.05
lalt + shift - r              : yabai -m space --balance
lalt + cmd - g                : ~/.local/bin/quadrant-tile
lalt + shift - space          : ~/.local/bin/toggle-menubar

# Focus (vim keys + arrows)
lalt - h                      : yabai -m window --focus west
lalt - j                      : yabai -m window --focus south
lalt - k                      : yabai -m window --focus north
lalt - l                      : yabai -m window --focus east
lalt - left                   : yabai -m window --focus west
lalt - down                   : yabai -m window --focus south
lalt - up                     : yabai -m window --focus north
lalt - right                  : yabai -m window --focus east

# Move (like Hyprland movewindow: re-split into that side)
lalt + shift - h              : yabai -m window --warp west
lalt + shift - j              : yabai -m window --warp south
lalt + shift - k              : yabai -m window --warp north
lalt + shift - l              : yabai -m window --warp east
lalt + shift - left           : yabai -m window --swap west
lalt + shift - down           : yabai -m window --swap south
lalt + shift - up             : yabai -m window --swap north
lalt + shift - right          : yabai -m window --swap east

# --- Workspaces (Spaces) ---------------------------------------------------
lalt - a                      : ~/.local/bin/ws focus prev
lalt - d                      : ~/.local/bin/ws focus next
lalt + shift - a              : ~/.local/bin/ws move prev
lalt + shift - d              : ~/.local/bin/ws move next

lalt - 1 : ~/.local/bin/ws focus 1
lalt - 2 : ~/.local/bin/ws focus 2
lalt - 3 : ~/.local/bin/ws focus 3
lalt - 4 : ~/.local/bin/ws focus 4
lalt - 5 : ~/.local/bin/ws focus 5
lalt - 6 : ~/.local/bin/ws focus 6
lalt - 7 : ~/.local/bin/ws focus 7
lalt - 8 : ~/.local/bin/ws focus 8
lalt - 9 : ~/.local/bin/ws focus 9
lalt - 0 : ~/.local/bin/ws focus 10

lalt + shift - 1 : ~/.local/bin/ws move 1
lalt + shift - 2 : ~/.local/bin/ws move 2
lalt + shift - 3 : ~/.local/bin/ws move 3
lalt + shift - 4 : ~/.local/bin/ws move 4
lalt + shift - 5 : ~/.local/bin/ws move 5
lalt + shift - 6 : ~/.local/bin/ws move 6
lalt + shift - 7 : ~/.local/bin/ws move 7
lalt + shift - 8 : ~/.local/bin/ws move 8
lalt + shift - 9 : ~/.local/bin/ws move 9
lalt + shift - 0 : ~/.local/bin/ws move 10

# Move window to the other display
lalt + ctrl + shift - h             : yabai -m window --display west; yabai -m display --focus west
lalt + ctrl + shift - l             : yabai -m window --display east; yabai -m display --focus east

# --- System ----------------------------------------------------------------
lalt + ctrl - l               : pmset displaysleepnow
lalt + cmd - y                : yabai --restart-service; skhd --restart-service

