# skhd bindings, Omarchy-style, ported from github.com/RyanAHayden/dotfiles (.config/hypr/bindings.lua)
# SUPER = physical left Cmd (lcmd), bound natively so these work even when Karabiner isn't running
# (after boot/login, around sleep). Right Cmd stays a normal Cmd, and Karabiner's Linux-style ctrl
# shortcuts (ctrl+c -> cmd+c) send right Cmd, so neither ever hits these.
# SUPER+ALT = Cmd + Option. Unbound Cmd combos (cmd+c/v/q/tab) still reach macOS apps.
# Option is never bound alone, so it reaches nvim/tmux as Meta (M-h, M-1..9, M-Enter, ...).
# Reload: skhd --restart-service

# --- Apps ------------------------------------------------------------------
lcmd - return                 : touch ~/.cache/yabai-new-window; open -na Ghostty
lcmd + alt - return           : touch ~/.cache/yabai-new-window; open -na Ghostty --args -e /opt/homebrew/bin/tmux new -A -s Work
lcmd + shift - b              : touch ~/.cache/yabai-new-window; open -na Helium --args --new-window
lcmd + shift - return         : touch ~/.cache/yabai-new-window; open -na Helium --args --new-window
lcmd + shift + alt - b        : touch ~/.cache/yabai-new-window; open -na Helium --args --incognito
lcmd + shift - f              : touch ~/.cache/yabai-new-window; osascript -e 'tell application "Finder"' -e 'make new Finder window to home' -e 'activate' -e 'end tell'
lcmd + shift - n              : touch ~/.cache/yabai-new-window; open -na Ghostty --args -e /opt/homebrew/bin/nvim
lcmd + shift - t              : touch ~/.cache/yabai-new-window; open -na Ghostty --args -e /opt/homebrew/bin/btop
lcmd + shift - g              : open -a Steam
# Discord, Spotify and KeePassXC live on the scratchpad (yabairc rules keep their windows there)
lcmd + shift - c              : ~/.local/bin/scratchpad show; open -a Discord
lcmd + shift - m              : ~/.local/bin/scratchpad show; open -a Spotify
lcmd + shift - 0x2C           : ~/.local/bin/scratchpad show; open -a KeePassXC
# macOS Dictation: setup.sh gives it the hidden F19 (0x50) shortcut, since it has no command to start it
lcmd + alt - space            : skhd -k "0x50"
# Screenshot: select an area, copied to the clipboard (macOS's own Ctrl+Option+Shift+4, see setup.sh, so skhd needs no
# Screen Recording permission). Ctrl+Shift+4 saves the area to a file instead, Ctrl+Shift+5 opens the screenshot toolbar.
lcmd + shift - s              : skhd -k "ctrl + alt + shift - 4"
# Sound panel from the menu bar (Control Center's Sound item, shown by setup.sh): output device, volume
lcmd + ctrl - s               : osascript -e 'tell application "System Events" to tell process "ControlCenter" to click (first menu bar item of menu bar 1 whose description is "Sound")'
# Bluetooth panel from the menu bar (Control Center's Bluetooth item, shown by setup.sh): devices, on/off
lcmd + ctrl - b               : osascript -e 'tell application "System Events" to tell process "ControlCenter" to click (first menu bar item of menu bar 1 whose description is "Bluetooth")'
lcmd - i                      : touch ~/.cache/yabai-new-window; open -na Ghostty --args -e /usr/bin/less ~/.config/skhd/skhdrc
lcmd + shift - q              : open -a Calculator
# Raycast: clipboard history and emoji picker; SUPER+Escape: system menu (.local/src/power-menu.swift)
lcmd + ctrl - v               : open -g "raycast://extensions/raycast/clipboard-history/clipboard-history"
lcmd + ctrl - e               : open -g "raycast://extensions/raycast/emoji-symbols/search-emoji-symbols"
lcmd - escape                 : ~/.local/bin/power-menu
lcmd + ctrl - w               : osascript -e 'tell application "System Events" to tell process "ControlCenter" to click (first menu bar item of menu bar 1 whose description starts with "Wi")'   # Wi-Fi menu (its name includes the connection state)
lcmd + ctrl - n               : ~/.local/bin/night-shift   # toggle Night Shift (Omarchy nightlight)
lcmd + ctrl - d               : open "x-apple.systempreferences:com.apple.Displays-Settings.extension"
lcmd + ctrl - p               : osascript -e 'tell application "System Events" to tell process "ControlCenter" to click (first menu bar item of menu bar 1 whose description is "Battery")'   # Battery menu


# --- Windows ---------------------------------------------------------------
lcmd - w                      : ~/.local/bin/close-window
lcmd + shift - w              : ~/.local/bin/force-kill-window
lcmd - q                      : ~/.local/bin/quit-app
# Minimize without the macOS animation: park the window on a hidden Space (yabai-helper); Option brings back the
# latest (so does switching to its app, or picking it in AltTab)
lcmd - m                      : ~/.local/bin/notify-post wm.hide
lcmd + alt - m                : ~/.local/bin/notify-post wm.unhide
lcmd + shift - p              : ~/.local/bin/yabai-pause   # pause/resume yabai (lets Cmd-drag reach macOS)
lcmd - f                      : yabai -m window --toggle zoom-fullscreen
lcmd + ctrl - f               : yabai -m window --toggle zoom-parent   # tiled fullscreen: fill its split only
lcmd + alt - f                : yabai -m window --toggle native-fullscreen
lcmd - t                      : yabai -m window --toggle float --grid 6:6:1:1:4:4
lcmd - o                      : ~/.local/bin/window-pop   # pop out: float centered, sticky, on top (again: put back)
lcmd - 0x2A                   : yabai -m window --toggle split
lcmd + shift - i              : yabai -m window --swap largest
lcmd + ctrl + shift - i       : yabai -m space --mirror y-axis
lcmd - 0x1B                   : yabai -m window --ratio rel:-0.05
lcmd - 0x18                   : yabai -m window --ratio rel:0.05
# Resize by px like Omarchy: Shift = height, Option = a little (25), Ctrl = a lot (300)
lcmd + shift - 0x1B           : ~/.local/bin/window-resize h -100
lcmd + shift - 0x18           : ~/.local/bin/window-resize h 100
lcmd + alt - 0x1B             : ~/.local/bin/window-resize w -25
lcmd + alt - 0x18             : ~/.local/bin/window-resize w 25
lcmd + shift + alt - 0x1B     : ~/.local/bin/window-resize h -25
lcmd + shift + alt - 0x18     : ~/.local/bin/window-resize h 25
lcmd + ctrl - 0x1B            : ~/.local/bin/window-resize w -300
lcmd + ctrl - 0x18            : ~/.local/bin/window-resize w 300
lcmd + ctrl + shift - 0x1B    : ~/.local/bin/window-resize h -300
lcmd + ctrl + shift - 0x18    : ~/.local/bin/window-resize h 300
lcmd + shift - r              : yabai -m space --balance
lcmd + alt - g                : ~/.local/bin/quadrant-tile
lcmd + shift - space          : ~/.local/bin/toggle-menubar
lcmd - 0x33                   : ~/.local/bin/window-opacity toggle   # Backspace: transparent/opaque
lcmd + alt - 0x33             : ~/.local/bin/window-opacity -0.05
lcmd + shift + alt - 0x33     : ~/.local/bin/window-opacity +0.05
lcmd + shift - 0x33           : yabai -m space --toggle padding; yabai -m space --toggle gap   # gaps on this Space
lcmd + alt - l                : ~/.local/bin/space-layout        # bsp -> stack -> float
lcmd + alt + shift - l        : ~/.local/bin/space-layout back

# Groups (Omarchy tabs) = yabai stacks
lcmd - g                      : ~/.local/bin/window-group toggle
lcmd + alt - left             : ~/.local/bin/window-group into west
lcmd + alt - right            : ~/.local/bin/window-group into east
lcmd + alt - up               : ~/.local/bin/window-group into north
lcmd + alt - down             : ~/.local/bin/window-group into south
# Option+Tab cycles focus through the windows on this workspace (Cmd+Tab = SUPER+Tab is AltTab, all windows)
alt - tab                     : ~/.local/bin/window-cycle next
shift + alt - tab             : ~/.local/bin/window-cycle prev
lcmd + alt - tab              : ~/.local/bin/window-group next
lcmd + alt + shift - tab      : ~/.local/bin/window-group prev
lcmd + ctrl - left            : ~/.local/bin/window-group prev
lcmd + ctrl - right           : ~/.local/bin/window-group next

# Scratchpad = 11th Space: SUPER+S goes there and back, +Option sends the window there (from it: back)
lcmd - s                      : ~/.local/bin/scratchpad toggle
lcmd + alt - s                : ~/.local/bin/scratchpad move

# Focus (vim keys + arrows)
lcmd - h                      : yabai -m window --focus west
lcmd - j                      : yabai -m window --focus south
lcmd - k                      : yabai -m window --focus north
lcmd - l                      : yabai -m window --focus east
lcmd - left                   : yabai -m window --focus west
lcmd - down                   : yabai -m window --focus south
lcmd - up                     : yabai -m window --focus north
lcmd - right                  : yabai -m window --focus east

# Move (like Hyprland movewindow: re-split into that side)
lcmd + shift - h              : yabai -m window --warp west
lcmd + shift - j              : yabai -m window --warp south
lcmd + shift - k              : yabai -m window --warp north
lcmd + shift - l              : yabai -m window --warp east
lcmd + shift - left           : yabai -m window --swap west
lcmd + shift - down           : yabai -m window --swap south
lcmd + shift - up             : yabai -m window --swap north
lcmd + shift - right          : yabai -m window --swap east

# --- Workspaces (Spaces) ---------------------------------------------------
lcmd - a                      : ~/.local/bin/ws focus prev
lcmd - d                      : ~/.local/bin/ws focus next
lcmd + shift - a              : ~/.local/bin/ws move prev
lcmd + shift - d              : ~/.local/bin/ws move next

lcmd - 1 : ~/.local/bin/ws focus 1
lcmd - 2 : ~/.local/bin/ws focus 2
lcmd - 3 : ~/.local/bin/ws focus 3
lcmd - 4 : ~/.local/bin/ws focus 4
lcmd - 5 : ~/.local/bin/ws focus 5
lcmd - 6 : ~/.local/bin/ws focus 6
lcmd - 7 : ~/.local/bin/ws focus 7
lcmd - 8 : ~/.local/bin/ws focus 8
lcmd - 9 : ~/.local/bin/ws focus 9
lcmd - 0 : ~/.local/bin/ws focus 10

# Move window to Space N and follow: yabai-helper switches and moves over yabai's socket (no flash, ~1 ms to send)
lcmd + shift - 1 : ~/.local/bin/notify-post wm.move 1
lcmd + shift - 2 : ~/.local/bin/notify-post wm.move 2
lcmd + shift - 3 : ~/.local/bin/notify-post wm.move 3
lcmd + shift - 4 : ~/.local/bin/notify-post wm.move 4
lcmd + shift - 5 : ~/.local/bin/notify-post wm.move 5
lcmd + shift - 6 : ~/.local/bin/notify-post wm.move 6
lcmd + shift - 7 : ~/.local/bin/notify-post wm.move 7
lcmd + shift - 8 : ~/.local/bin/notify-post wm.move 8
lcmd + shift - 9 : ~/.local/bin/notify-post wm.move 9
lcmd + shift - 0 : ~/.local/bin/notify-post wm.move 10


# SUPER+Shift+Option+N: move window there silently (stay here)
lcmd + shift + alt - 1 : ~/.local/bin/ws move-silent 1
lcmd + shift + alt - 2 : ~/.local/bin/ws move-silent 2
lcmd + shift + alt - 3 : ~/.local/bin/ws move-silent 3
lcmd + shift + alt - 4 : ~/.local/bin/ws move-silent 4
lcmd + shift + alt - 5 : ~/.local/bin/ws move-silent 5
lcmd + shift + alt - 6 : ~/.local/bin/ws move-silent 6
lcmd + shift + alt - 7 : ~/.local/bin/ws move-silent 7
lcmd + shift + alt - 8 : ~/.local/bin/ws move-silent 8
lcmd + shift + alt - 9 : ~/.local/bin/ws move-silent 9
lcmd + shift + alt - 0 : ~/.local/bin/ws move-silent 10

lcmd + ctrl - tab   : ~/.local/bin/ws focus recent   # the Space you were on before

# Move window to the other display
lcmd + ctrl + shift - h             : yabai -m window --display west; yabai -m display --focus west
lcmd + ctrl + shift - l             : yabai -m window --display east; yabai -m display --focus east
lcmd + ctrl + shift - k                : yabai -m window --display north; yabai -m display --focus north
lcmd + ctrl + shift - j                : yabai -m window --display south; yabai -m display --focus south
lcmd + ctrl + shift - left             : yabai -m window --display west; yabai -m display --focus west
lcmd + ctrl + shift - right            : yabai -m window --display east; yabai -m display --focus east
lcmd + ctrl + shift - up               : yabai -m window --display north; yabai -m display --focus north
lcmd + ctrl + shift - down             : yabai -m window --display south; yabai -m display --focus south
ctrl + alt - tab                    : yabai -m display --focus next || yabai -m display --focus first
ctrl + alt + shift - tab            : yabai -m display --focus prev || yabai -m display --focus last
# Move this whole Space to the other display (renumbers Spaces: workspace numbers follow display order)
lcmd + shift + alt - left           : yabai -m space --display west; yabai -m display --focus west
lcmd + shift + alt - right          : yabai -m space --display east; yabai -m display --focus east
lcmd + shift + alt - up             : yabai -m space --display north; yabai -m display --focus north
lcmd + shift + alt - down           : yabai -m space --display south; yabai -m display --focus south
# Mirror displays: macOS's own Cmd+F1 (Cmd+brightness-down) shortcut
lcmd + ctrl - m                     : skhd -k "cmd - f1"

# --- System ----------------------------------------------------------------
lcmd + ctrl - l               : pmset displaysleepnow
lcmd + alt - y                : yabai --restart-service; skhd --restart-service


# --- Omarchy utilities -------------------------------------------------------
# Capture menu: macOS's screenshot/recording toolbar (its own Ctrl+Shift+5, see setup.sh)
lcmd + ctrl - c                     : skhd -k "ctrl + shift - 5"
# Notifications (SUPER+comma family). Left Cmd+, is taken from apps' Settings; right Cmd+, still opens them.
lcmd - 0x2B                         : ~/.local/bin/notifications dismiss
lcmd + alt - 0x2B                   : ~/.local/bin/notifications dismiss
lcmd + shift - 0x2B                 : ~/.local/bin/notifications dismiss-all
lcmd + ctrl - 0x2B                  : ~/.local/bin/notifications center
lcmd + shift + alt - 0x2B           : ~/.local/bin/notifications center
# Display scaling: step through the Retina "Looks like" sizes. Right Cmd+/ still reaches apps (comment toggle).
lcmd - 0x2C                         : ~/.local/bin/display-scale up
lcmd + alt - 0x2C                   : ~/.local/bin/display-scale down
