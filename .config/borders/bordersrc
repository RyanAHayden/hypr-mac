#!/usr/bin/env bash
# JankyBorders (brew services start borders): border on the focused window, in the current theme's colour
# (theme script; Starlight, the M3 Air's, until one is set)
border=$(cat ~/.local/state/theme/border 2>/dev/null || echo 0xffe8ddd0)
exec borders \
	style=round \
	hidpi=on \
	ax_focus=on \
	active_color="$border" \
	inactive_color=0x00000000 \
	width=6.0 \
	blacklist="iPhone Mirroring"
