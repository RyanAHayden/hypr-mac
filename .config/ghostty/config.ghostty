# Ghostty config. Ported from the Alacritty config in github.com/RyanAHayden/dotfiles.
font-family = JetBrainsMono Nerd Font Mono
font-size = 13
window-decoration = true
macos-titlebar-style = hidden
macos-window-buttons = hidden
# no split drag handle (the three dots at the top, shown on hover since 1.4): splits are tmux's
drag-handle = never
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true
# transparency is yabai's, for every app alike: unfocused windows fade (yabairc), SUPER+Backspace pins one opaque
background-opacity = 1.0
# Option acts as Meta so nvim/tmux M-* binds work (binds leave Option alone; SUPER is left Cmd)
macos-option-as-alt = true
# Linux-style terminal copy/paste (Karabiner leaves ctrl as real ctrl in here); cmd+c/v still work too
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
confirm-close-surface = false
quit-after-last-window-closed = true
# Shift+Return / Alt+Shift+Return as CSI-u, so TUIs and tmux (M-S-Enter) can tell them apart
keybind = shift+enter=text:\x1b[13;2u
keybind = alt+shift+enter=text:\x1b[13;4u
# no ssh wrapper from Ghostty: since 1.4 its ssh-env runs ssh under `ghostty +ssh` and replaces the ssh() in .zshrc
# (reconnect, mode cleanup); when that helper died it left ssh orphaned holding the terminal raw. .zshrc's ssh() sends
# TERM=xterm-256color itself, so servers without Ghostty's terminfo don't fail with "missing or unsuitable terminal".
shell-integration-features = no-ssh-env,no-ssh-terminfo

# colors: the current theme (theme script, Raycast's Switch Theme), which reloads Ghostty with SIGUSR2
# Ghostty 1.4 needs a conditional theme to report dark mode correctly (ghostty#13604).
# The variants must differ; the current theme's config overrides their palettes.
theme = light:GitHub Light Default,dark:GitHub Dark
config-file = ?~/.local/state/theme/ghostty.conf
